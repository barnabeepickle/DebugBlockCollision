key.category.debugblockcollision=Debug Block Collision Overlay

key.debugblockcollision.overlay=Toggle Box Rendering
key.debugblockcollision.mode=Change Box Rendering Mode

debug.debugblockcollision=Block collision boxes: %s
debug.debugblockcollision.on=Overlay Shown
debug.debugblockcollision.off=Overlay Hidden

debug.debugblockcollision.radius=Mode: Radius
debug.debugblockcollision.radius.info=All collision/bounding boxes that are not single full-blocks will render within a radius around the player.

debug.debugblockcollision.collided=Mode: Collision
debug.debugblockcollision.collided.info=Only collision/bounding boxes that the player is currently colliding with will render.

debug.debugblockcollision.hovered=Mode: Crosshair
debug.debugblockcollision.hovered.info=Only the collision/bounding of the block the player is looking at will render (sneaking will cause only the single box looked at to render).

debug.debugblockcollision.color_key=§fOverlay Color Key:
debug.debugblockcollision.color_key.green=§2Green §r= §2Full Collision Boxes
